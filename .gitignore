# Public repository: allow source explicitly; ignore everything else by default.
# Never force-add original game files, lifted game code or local work notes.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements-audit.txt
!/runtime/
!/probe/
!/scripts/
!/tests/
!/config/
!/packaging/
!/third_party/

/runtime/*
!/runtime/*.c
!/runtime/*.h
!/runtime/*.inc
/probe/*
!/probe/*.c
!/probe/*.h
!/probe/*.def
/scripts/*
!/scripts/*.py
!/scripts/*.sh
/tests/*
!/tests/*.c
!/tests/*.h
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/*.c
/config/*
!/config/runtime_seeds.json
/packaging/*
!/packaging/*.sh
!/packaging/*.cfg
!/packaging/README.txt
!/packaging/port.json
!/packaging/gameinfo.xml
!/packaging/Dockerfile.cross
!/.dockerignore

# Only the build/runtime sources and upstream notices are vendored.
/third_party/*
!/third_party/pcrecomp/
/third_party/pcrecomp/*
!/third_party/pcrecomp/LICENSE
!/third_party/pcrecomp/NOTICE
!/third_party/pcrecomp/runtime/
!/third_party/pcrecomp/tools/

# Defense in depth, including files copied into an allowed source directory.
**/__pycache__/
**/.git/
**/.agents/
**/.codex/
**/.aws/
**/AGENTS.md
**/SKILL.md
**/captures/
**/saves/
**/userdata/
**/evidence/
*.pyc
*.pyo
*.o
*.a
*.so
*.so.*
*.aarch64
*.exe
*.dll
*.dat
*.sch
*.key
*.bin
*.bmp
*.png
*.jpg
*.jpeg
*.dds
*.psf
*.wav
*.mp3
*.avi
*.zip
*.tar
*.gz
*.7z
*.iso
*.log
*.csv
*.core
core
.env
.env.*

# Generated from the player's executable, despite living beside host sources.
/runtime/geometry_fast.c
/runtime/quaternion_fast.c
/runtime/matrix_inverse_fast.c
/runtime/physics_rank_update.inc

# Checksums and filenames only; no game contents.
!/config/game-files.sha256
!/config/extractor-packages.json

!/licenses/
/licenses/*
!/licenses/*.txt
!/tests/*.py
